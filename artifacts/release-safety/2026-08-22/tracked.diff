+  return () => {
+    events.forEach((ev) => window.removeEventListener(ev, cham));
+    document.removeEventListener('visibilitychange', khiHienLai);
+    window.removeEventListener(LOCK_REQUEST_EVENT, khiCoLenh);
+  };
+}
