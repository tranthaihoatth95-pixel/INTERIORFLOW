# ============================================================================
# PHASE 1 — ĐANG DÙNG (app không chạy đúng/thiếu tính năng nếu bỏ trống)
# ============================================================================
# SQLite local. Worktree PHẢI dùng đường dẫn TUYỆT ĐỐI riêng (xem docs/IF-CORE-SCHEMA.md
# mục "Luật worktree & Prisma") — relative gây Prisma lỗi P2021.
DATABASE_URL="file:./prisma/dev.db"

# Bật route demo/dev không có entry UI thật (/cad-library-demo, /demo-resort) — production
# build KHÔNG set biến này (hoặc khác 'true') sẽ tự redirect '/' (Sprint "ĐỔ NỀN 1B", T2, 26/07).
NEXT_PUBLIC_DEMO=

# --- Auth ---
# Bí mật ký JWT session (if_session) — đổi khi lên môi trường thật
AUTH_SECRET=

# Google Sign-In (OAuth 2.0 tự viết, không NextAuth). Tạo ở Google Cloud Console:
# APIs & Services → Credentials → OAuth client ID (Web application),
# thêm Authorized redirect URI:  http://localhost:3000/api/auth/google/callback
# (đổi host/port theo origin thật khi chạy LAN). Thiếu 2 key này → nút Google hiện "cần cấu hình".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign in with Apple — CHƯA BẬT (cần Apple Developer trả phí + key .p8). Để sẵn khung:
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ─── NGUỒN ẢNH NGOÀI (tuỳ chọn) — xem docs/IMAGE-SOURCES.md ───
# Unsplash: đăng ký app miễn phí tại https://unsplash.com/oauth/applications → "Access Key".
# THIẾU biến này thì nguồn Unsplash TỰ ẨN khỏi UI (không lỗi). Openverse không cần key.
# Pinterest: KHÔNG có biến env — Pinterest không cung cấp API tìm ảnh công khai; IF chỉ hỗ trợ
# dán URL ảnh trực tiếp / upload (lý do chi tiết trong lib/stock-photos.ts).
UNSPLASH_ACCESS_KEY=

# Phase 2+ — chưa dùng ở Phase 1 (node AI báo "chưa cấu hình" nếu thiếu, app vẫn chạy)
FAL_KEY=
ANTHROPIC_API_KEY=
# (REDIS_URL / S3_* / NEXTAUTH_* đã bị xoá khỏi file này 26/07 — KHÔNG có dòng code nào đọc
# tới. Auth là JWT tự viết bằng `jose` + cookie `if_session`, KHÔNG dùng next-auth. Storage
# ảnh là đĩa local `./uploads`, KHÔNG S3/cloud — xem mô hình phát hành ở
# docs/IF-CORE-SCHEMA.md mục 1D. Cần lại khi ĐỔI mô hình phát hành, không phải giờ.)

# ============================================================================
# TÍCH HỢP DỊCH VỤ NGOÀI (server-only — TUYỆT ĐỐI không thêm tiền tố NEXT_PUBLIC_).
# Redirect URI mỗi provider:  <origin>/api/integrations/<provider>/callback
# Hướng dẫn lấy khoá + rủi ro: docs/INTEGRATIONS.md. Thiếu khoá → provider hiện "chưa cấu hình".
# ============================================================================
# Khoá mã hoá token OAuth at-rest (BẮT BUỘC nếu dùng tích hợp OAuth). Tạo: openssl rand -base64 32
INTEGRATION_ENC_KEY=

# Google Workspace (Gmail/Calendar/Drive) — DÙNG LẠI GOOGLE_CLIENT_ID/SECRET ở trên.
# MS365 (Microsoft Graph — Outlook mail/calendar) + ĐĂNG NHẬP MICROSOFT (app/api/auth/microsoft).
# Cùng MỘT Azure App Registration — hướng dẫn: docs/INTEGRATIONS.md mục "Đăng nhập Microsoft".
# Redirect URI login:  <origin>/api/auth/microsoft/callback
MS365_CLIENT_ID=
MS365_CLIENT_SECRET=
MS365_TENANT=common

# Zoom (tạo meeting) — Zoom Marketplace OAuth app.
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Team API nội bộ (adapter generic) — chờ spec đội.
TEAM_API_BASE=
TEAM_API_TOKEN=

# Zalo Official Account / ZNS (KHÔNG hỗ trợ Zalo cá nhân).
ZALO_OA_APP_ID=
ZALO_OA_SECRET=

# Spotify (metadata/nhúng — playback đầy đủ cần SDK+premium).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# YouTube Data API v3 (tìm/nhúng video — quota-limited). (YOUTUBE_CLIENT_ID/SECRET nếu cần OAuth.)
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Apple Music (MusicKit) — STUB, chưa dựng flow. Cần Apple Developer + .p8.
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_PRIVATE_KEY=

# Lark/Feishu Base (Bitable) — server-to-server, KHÔNG OAuth per-user. Đọc base(s) RIÊNG của
# Hoà (KHÔNG phải base dùng chung công ty — sửa tiền đề sai 30/07). Home/Gallery "Đồng bộ tiến
# độ" + panel "Chi tiết" (docs/RESEARCH-HOME-GALLERY-DASHBOARD.md). Hướng dẫn tạo app + lấy
# khoá: docs/INTEGRATIONS.md mục "Lark/Feishu Base".
LARK_APP_ID=
LARK_APP_SECRET=
# https://open.larksuite.com (Lark quốc tế, mặc định) hoặc https://open.feishu.cn (Feishu TQ).
LARK_API_BASE=

# --- Base "Quản lý Công việc" ("Chi tiết công việc" + "Nhân sự") — base THƯỜNG, không phải Wiki.
# Token của chính cái Base (phần {app_token} trong URL base, KHÁC table_id) — bắt buộc để gọi
# Bitable API, không đoán được từ App ID/Secret.
LARK_WORK_APP_TOKEN=
# Tên cũ trước 7.1.19 — vẫn được đọc nếu LARK_WORK_APP_TOKEN trống (tương thích ngược, KHÔNG
# bắt buộc điền cả hai).
LARK_BASE_APP_TOKEN=
# table_id 2 bảng — có mặc định đúng theo báo cáo đã verify, đổi nếu Larkbase tái cấu trúc.
LARK_TASK_TABLE_ID=tblnjLehkr6DRMJN
LARK_HR_TABLE_ID=tblUvVYG5j70FCTn

# --- Base "ATLAS Material Library" — nằm TRONG Lark WIKI, không phải Drive base thường (7.1.19,
# docs/REVIEW-SPEC-BOQ-LARK-2026-07-30.md §3). node_token ≠ app_token — điền node_token (lấy từ
# URL trang Wiki) để app tự giải ra app_token và cache, HOẶC điền thẳng app_token nếu đã biết
# (đỡ phải resolve mỗi cold-start). Không suy ra 1 giá trị từ giá trị kia.
LARK_ATLAS_NODE_TOKEN=
LARK_ATLAS_APP_TOKEN=
# table_id bảng "Vật liệu" TRONG base ATLAS — KHÔNG có mặc định (khác LARK_TASK_TABLE_ID/
# LARK_HR_TABLE_ID) vì chưa từng verify field thật (2.1.9.r, 30/07). Bắt buộc điền để
# /api/atlas-materials/sync chạy được.
LARK_ATLAS_MATERIAL_TABLE_ID=

# --- /workhub — CÔ LẬP (IF-WORKHUB-CONTAINMENT-001, 27/08) ---
# Bề mặt `/workhub` từng mở được KHI CHƯA ĐĂNG NHẬP, chào đích danh một người, hiện một ngày
# đóng băng, và nhúng outlook/pinterest/zalo/microsoft365/canva/youtube bằng <iframe>.
# Nay đứng sau hai cờ, CẢ HAI mặc định TẮT. Bằng chứng: scripts/proof/workhub-containment.mjs
#
# Cờ chính. Chưa đặt ⇒ /workhub trả trạng thái "chưa được bật" (KHÔNG phải lỗi, KHÔNG phải
# thiếu quyền — ba trạng thái tách bạch, xem lib/workhub/cong.ts).
NEXT_PUBLIC_IF_WORKHUB=
# Cờ RIÊNG cho việc nhúng miền NGOÀI bằng iframe. Tách khỏi cờ trên có chủ ý: bật /workhub để
# xem bố cục là một quyết định; mở một cửa ra Internet ngay trong vỏ app là quyết định KHÁC,
# nặng hơn. Gộp hai cờ là buộc người bật phải nhận cả hai mà không biết.
NEXT_PUBLIC_IF_WORKHUB_EXTERNAL=
