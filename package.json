{
  "name": "interiorflow",
  "version": "0.1.0",
  "private": true,
  "description": "InteriorFlow — integrated workspace for interior design delivery (native desktop).",
  "author": "InteriorFlow",
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "backup:offsite": "node scripts/backup-offsite.mjs",
    "check:mocks": "node scripts/check-mocks.mjs",
    "check:chot": "node scripts/check-chot.mjs",
    "soi:frontier": "node scripts/soi-frontier.mjs",
    "soi:hinh-hoc": "node scripts/soi-hinh-hoc.mjs",
    "soi:tu-dien": "node scripts/soi-tu-dien.mjs",
    "soi:thao-tac": "node scripts/soi-thao-tac.mjs",
    "soi:contract": "node scripts/soi-contract.mjs",
    "release:preflight": "node scripts/release-preflight.mjs",
    "license:check": "license-checker-rseidelsohn --production --onlyAllow 'MIT;ISC;Apache-2.0;BSD-2-Clause;BSD-3-Clause;CC0-1.0;OFL-1.1;LGPL-3.0-or-later;Zlib;BlueOak-1.0.0;0BSD;Python-2.0' --excludePackages 'interiorflow@0.1.0;@mlightcad/libredwg-web@0.7.7;caniuse-lite@1.0.30001800' --summary",
    "test": "npm run license:check && npm run check:chot && find . -name '*.test.ts' -not -path '*/node_modules/*' -not -path '*/.worktrees/*' -not -name 'edgecase-concurrency.test.ts' -print0 | xargs -0 -n1 -P8 sh -c 'node_modules/.bin/sucrase-node \"$0\"'",
    "postinstall": "prisma generate",
    "electron": "electron .",
    "electron:dev": "cross-env ELECTRON_START_URL=http://localhost:3000 concurrently -k -n NEXT,ELECTRON -c blue,magenta \"next dev\" \"wait-on tcp:3000 && electron .\"",
    "electron:build": "next build && electron-builder --win --x64",
    "electron:build:win": "next build && electron-builder --win --x64",
    "electron:pack:win": "electron-builder --win --x64",
    "electron:build:mac": "next build && electron-builder --mac",
    "electron:publish": "next build && electron-builder --win --x64 --publish always"
  },
  "dependencies": {
    "@fal-ai/client": "^1.10.1",
    "@mlightcad/libredwg-web": "^0.7.7",
    "@prisma/client": "^6.19.3",
    "@xyflow/react": "^12.11.1",
    "ag-psd": "^31.0.2",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "electron-updater": "^6.3.9",
    "framer-motion": "^12.42.2",
    "jose": "^6.2.3",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.23.0",
    "next": "14.2.35",
    "pptxgenjs": "^3.12.0",
    "prisma": "^6.19.3",
    "react": "^18",
    "react-dom": "^18",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "three": "0.185.1",
    "three-bvh-csg": "^0.0.18",
    "three-mesh-bvh": "^0.9.14",
    "unpdf": "^1.6.2",
    "utif": "^3.1.0",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.14"
  },
  "licenseNotes": "@mlightcad/libredwg-web (DWG import) is GPL-3.0 — usage isolated to lib/cad/dwg-worker.ts (Web Worker, not bundled into main app code). ⚠️ UNRESOLVED: InteriorFlow is positioned as an INDEPENDENT, GLOBAL product, so the previous 'internal tool, not distributed' rationale for the GPL-3.0 dependency NO LONGER APPLIES. The DWG import path MUST be re-licensed, replaced, or fully isolated (separate process/service) BEFORE any external distribution or sale. See docs/LICENSE-NOTES.md and docs/RESEARCH-DWG-LICENSE.md.",
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/three": "0.185.3",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "license-checker-rseidelsohn": "^4.4.2",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.interiorflow.app",
    "productName": "InteriorFlow",
    "copyright": "InteriorFlow",
    "publish": [
      {
        "provider": "github",
        "owner": "tranthaihoatth95-pixel",
        "repo": "INTERIORFLOW"
      }
    ],
    "directories": {
      "output": "dist-installer",
      "buildResources": "electron/icons"
    },
    "files": [
      "electron/**/*",
      ".next/**/*",
      "prisma/**/*",
      "public/**/*",
      "node_modules/**/*",
      "node_modules/.prisma/**/*",
      "node_modules/@prisma/engines/**/*",
      "next.config.mjs",
      "package.json",
      "!**/node_modules/.cache/**",
      "!.next/cache/**",
      "!node_modules/.bin/**",
      "!prisma/*.db*",
      "!**/*.map",
      "!node_modules/.prisma/client/libquery_engine-linux-*",
      "!node_modules/@prisma/engines/*linux*"
    ],
    "extraResources": [
      {
        "from": "node_modules/.prisma",
        "to": "app/node_modules/.prisma",
        "filter": [
          "**/*",
          "!**/*.db",
          "!**/*.db-journal"
        ]
      }
    ],
    "asar": false,
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icons/icon.png"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "electron/icons/icon.png",
      "category": "public.app-category.graphics-design",
      "identity": null
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "InteriorFlow"
    }
  }
}
