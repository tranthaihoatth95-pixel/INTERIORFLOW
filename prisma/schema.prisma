generator client {
  provider      = "prisma-client-js"
  // binaryTargets: "native" = engine cho HĐH đang build (Mac/Linux dev); "windows" = engine
  // Query cho bản đóng gói .exe chạy trên Windows. Bắt buộc để bản cài Windows có
  // libquery_engine-windows.dll.node. Build .exe CHUẨN vẫn nên chạy NATIVE trên máy Windows
  // (npm ci ở đó tự lấy cả schema-engine-windows.exe cho `prisma db push` lúc app khởi động).
  // 08/08 (p12 NỀN DỮ LIỆU VIỆC 3): +2 target Linux ARM để test Prisma chạy được trong hộp cát/
  // CI Linux (trước đó gãy: "Prisma Client could not locate the Query Engine for runtime
  // linux-arm64-openssl-3.0.x ... generated for darwin-arm64"). Kích thước tăng ghi ở
  // docs/M-NEN-DL-OUT.md — TỔNG quyết có giữ cho gói .dmg hay tách generate riêng cho CI.
  binaryTargets = ["native", "windows", "linux-arm64-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

// SQLite cho bản chạy nội bộ / LAN — lên cloud chỉ cần đổi provider sang postgresql (Supabase)
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  // email/phone: cần ÍT NHẤT MỘT trong hai (enforce trong code — SQLite/Prisma không có CHECK).
  // email nullable để cho phép đăng ký bằng SĐT; phone chuẩn hoá dạng 0xxxxxxxxx (VN).
  email        String?  @unique
  phone        String?  @unique
  name         String
  passwordHash String
  credits      Int      @default(200)
  isAdmin      Boolean  @default(false)
  lastSeenAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  // Avatar config JSON — schema: { base:1..4, hair:1..8, hairColor:'black|brown|blonde|red|silver',
  // glasses:'none|round|square|aviator|rimless|cateye', hat:'none|fedora|beanie|cap|headphone|hairband',
  // shirt:'hoodie|sweater|blazer|tshirt|turtleneck|dress', shirtColor:'navy|orange|beige|gray|white' }.
  // Null = chưa chọn → fallback deterministic từ id.
  avatar       String?

  flows        Flow[]
  transactions CreditTransaction[]
  messages     ChatMessage[]
  assets       LibraryAsset[]
  projects     Project[]
  integrations IntegrationAccount[]
  larkUserMaps LarkUserMap[]
  memberships  ProjectMember[]
  guModels     GuModel[]
}

// Token OAuth của user cho từng dịch vụ ngoài (google/ms365/zoom/zalo/spotify/youtube/team...).
// accessToken/refreshToken LƯU DẠNG MÃ HOÁ (AES-256-GCM, xem lib/integrations/crypto.ts) —
// SQLite là file trên đĩa, không lưu token thô. Mỗi user × provider chỉ 1 bản ghi.
model IntegrationAccount {
  id           String    @id @default(cuid())
  userId       String
  provider     String
  accessToken  String // đã mã hoá
  refreshToken String? // đã mã hoá
  scope        String    @default("")
  expiresAt    DateTime?
  meta         String? // JSON tuỳ dịch vụ (account id, email, tenant...)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

model Project {
  id              String   @id @default(cuid())
  userId          String
  name            String
  clientName      String?
  createdAt       DateTime @default(now())
  // ══ MỚI (docs/RESEARCH-HOME-GALLERY-DASHBOARD.md §2.1) ══ — "Mã DA" bên Larkbase, gán TUỲ
  // CHỌN lúc tạo/sửa dự án ("Liên kết Larkbase"). Optional — không phải Project nào cũng có
  // mã Larkbase (dự án mới trong IF trước khi phòng dự án tạo task tương ứng bên Larkbase).
  // ⚠️ DEPRECATED-ĐANG-CHUYỂN (07/08, p12 — G-M9-01/§0v "lõi không mang tên nhà cung cấp"):
  // cột này là tên nhà cung cấp nằm trong bảng LÕI. Đích đến: ExternalRef{system:'lark',
  // entityType:'project', entityId:Project.id, externalId:<mã DA>} — backfill bằng
  // scripts/migrate-lark-project-code-to-external-ref.ts SAU khi ExternalRef migrate.
  // KHÔNG xoá cột lúc này (KS4 + còn 13 file đọc nó — grep 07/08, xem docs/M-DATA-OUT.md).
  larkProjectCode String?

  // ══ MỚI (ACCESS-CONTROL M1, docs/RESEARCH-ACCESS-CONTROL.md §2.3) — additive, có default
  // → DB/row cũ không vỡ. currentStage trùng bộ ID nội bộ lib/phases.ts ('concept'|'render'|
  // 'present'); stageLocked = true khi chặng trước đã qua GATE (đóng băng snapshot).
  currentStage String  @default("concept")
  stageLocked  Boolean @default(false)

  // ══ MỚI (26/07, local-first · docs/IF-CORE-SCHEMA.md §1D/§2C) — chuẩn bị Pha 2/3 đồng bộ.
  // rev tăng mỗi lần sửa (hoà giải xung đột); deletedAt = xoá mềm (mọi query PHẢI lọc
  // deletedAt: null, xem lib/server/access.ts); lastEditedBy/lastEditedDevice = truy vết ai/
  // máy nào sửa gần nhất (lastEditedDevice CHƯA có cơ chế deviceId thật — luôn null tới khi
  // Pha 2 dựng cơ chế đó, cột có sẵn để khỏi migrate lại).
  updatedAt        DateTime  @default(now()) @updatedAt
  rev              Int       @default(0)
  deletedAt        DateTime?
  lastEditedBy     String?
  lastEditedDevice String?

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  flows    Flow[]
  notebook ProjectNotebook?
  members  ProjectMember[]
  // M-SCOPE VIỆC 2 (07/08) — xem khối chú thích TASK_TABLES_READY phía cuối file.
  tasks          Task[]
  workflowStates WorkflowState[]

  @@index([larkProjectCode])
  @@index([deletedAt])
}

// ══ MỚI (ACCESS-CONTROL M1) ══ Thành viên dự án — nguồn chân lý DUY NHẤT cho "ai thấy/sửa
// dự án nào". role là String vì SQLite không có enum (RESEARCH-ACCESS-CONTROL.md §2.3);
// ràng buộc 5 giá trị 'owner'|'crea'|'drafter'|'bim'|'viewer' nằm ở lib/server/access.ts.
model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      String // 'owner' | 'crea' | 'drafter' | 'bim' | 'viewer'
  joinedAt  DateTime @default(now())

  // ══ MỚI (26/07, local-first · docs/IF-CORE-SCHEMA.md §1D/§2C) ══ — xem ghi chú ở Project.
  // ⚠️ deletedAt KHÔNG nằm trong @@unique([projectId,userId]) — gỡ rồi mời lại CÙNG user thì
  // hàng cũ (đã set deletedAt) vẫn còn đó và sẽ đụng unique constraint khi tạo mới. Chỗ gọi
  // (app/api/projects/[id]/members/route.ts POST) phải "hồi sinh" hàng cũ (deletedAt: null)
  // thay vì create mới — xem comment tại đó.
  updatedAt        DateTime  @default(now()) @updatedAt
  rev              Int       @default(0)
  deletedAt        DateTime?
  lastEditedBy     String?
  lastEditedDevice String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId]) // 1 người 1 vai / 1 dự án (Q6 RESEARCH — chốt giữ unique)
  @@index([userId]) // truy vấn nóng: "dự án của tôi"
  @@index([deletedAt])
}

// ══════════════════════════════════════════════════════════════════════════
// Project Notebook (Phase 1) — "NotebookLM riêng cho mỗi project".
// User upload PDF/ảnh/note → extract → chunk → embed (NVIDIA) → cosine retrieve
// tại chỗ (JSON blob) → RAG cho Vitals chat. Không thêm pgvector/sqlite-vss
// (option 🅐: đơn giản, không dependency mới; hàng nghìn chunk vẫn nhanh trong Node).
// ══════════════════════════════════════════════════════════════════════════
model ProjectNotebook {
  id        String   @id @default(cuid())
  projectId String   @unique
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sources NotebookSource[]
  chunks  NotebookChunk[]
}

model NotebookSource {
  id          String          @id @default(cuid())
  notebookId  String
  notebook    ProjectNotebook @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  kind        String // "pdf" | "image" | "text" | "url" | "meeting-note"
  title       String
  originalUrl String?
  filePath    String? // path lưu local (uploads/notebook/{projectId}/{sourceId}.{ext})
  mimeType    String?
  sizeBytes   Int?
  status      String          @default("processing") // "processing" | "ready" | "error"
  errorMsg    String?
  createdAt   DateTime        @default(now())

  chunks NotebookChunk[]

  @@index([notebookId])
}

model NotebookChunk {
  id         String          @id @default(cuid())
  notebookId String
  notebook   ProjectNotebook @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  sourceId   String
  source     NotebookSource  @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  page       Int?
  content    String
  embedding  String // JSON array float32[]
  tokens     Int?
  createdAt  DateTime        @default(now())

  @@index([notebookId])
  @@index([sourceId])
}

model Flow {
  id         String   @id @default(cuid())
  userId     String
  projectId  String?
  name       String   @default("Untitled flow")
  graphJson  String   @default("{\"nodes\":[],\"edges\":[]}")
  coverUrl   String   @default("") // ảnh bìa card chọn tay (url thư viện hoặc cover mặc định); trống = fallback hash-cover
  status     String   @default("") // dòng trạng thái ngắn hiện dưới tên dự án; trống = "Chưa có ghi chú"
  version    Int      @default(1)
  shareToken String?  @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // ══ MỚI (26/07, local-first · docs/IF-CORE-SCHEMA.md §1D/§2C) ══ — xem ghi chú ở Project.
  // `rev` KHÁC `version` phía trên: `version`/`FlowVersion` là snapshot NGHIỆP VỤ (tăng khi
  // user bấm Run — nội dung khác nhau từng bản); `rev` là bộ đếm THUẦN KỸ THUẬT cho hoà giải
  // xung đột đồng bộ (tăng ở MỌI lần ghi, kể cả autosave không snapshot).
  rev              Int       @default(0)
  deletedAt        DateTime?
  lastEditedBy     String?
  lastEditedDevice String?

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  project  Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  versions FlowVersion[]

  @@index([deletedAt])
}

// snapshot khi Run flow — version không ghi đè
model FlowVersion {
  id        String   @id @default(cuid())
  flowId    String
  version   Int
  graphJson String
  createdAt DateTime @default(now())

  flow Flow @relation(fields: [flowId], references: [id], onDelete: Cascade)
}

model CreditTransaction {
  id        String   @id @default(cuid())
  userId    String
  amount    Int // âm = trừ, dương = nạp/hoàn
  reason    String
  jobRef    String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  text      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// thư viện dùng chung cả team — file lưu ./uploads, DB giữ metadata
model LibraryAsset {
  // Task #19 (id ảnh chuẩn `img_…`): KHÔNG thêm cột DB cho LibraryAsset — `id` cuid dưới đây ĐÃ là
  // định danh ổn định, độc lập tên file random (`path`); tham chiếu đã đi qua id (URL /api/library/{id}/file),
  // nên đổi tên/di chuyển file KHÔNG vỡ liên kết. App phủ id này vào không gian `img_` bằng cách DẪN XUẤT
  // tất định (`imgIdFromKey(id)` = `img_<cuid>`, xem lib/img-id.ts) ở ranh giới API — không migrate, không
  // regenerate Prisma client (node_modules dùng CHUNG với main + worktree khác qua symlink: thêm cột rồi
  // regenerate sẽ khiến phiên main đang chạy lỗi P2022 khi SELECT cột dev.db của nó chưa có). Least-disruptive.
  id        String   @id @default(cuid())
  userId    String
  name      String
  category  String
  tags      String   @default("")
  mime      String
  path      String
  // ---- Gu Engine: chưng cất gu từ ref (07/07) ----
  usage     String   @default("ref-render") // RefUsage: ref-render | slide | material | layout | cad | brief
  palette   String   @default("") // JSON string[] hex — màu chủ đạo trích từ ảnh
  caption   String   @default("") // mô tả gu (VLM hoặc tay)
  content   String? // chữ bóc từ PDF (đề bài/hồ sơ) cho AI đọc
  w         Int      @default(0)
  h         Int      @default(0)
  createdAt DateTime @default(now())

  // ══ MỚI (26/07, local-first · docs/IF-CORE-SCHEMA.md §1D/§2C) ══ — xem ghi chú ở Project.
  // Soft-delete ở đây KHÔNG xoá file vật lý trong ./uploads (route DELETE đã sửa để chỉ set
  // deletedAt) — xoá file thật là việc của job dọn dẹp SAU NÀY, chưa làm ở đây (mục đích xoá
  // mềm là còn khôi phục được).
  updatedAt        DateTime  @default(now()) @updatedAt
  rev              Int       @default(0)
  deletedAt        DateTime?
  lastEditedBy     String?
  lastEditedDevice String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([deletedAt])
}

// ══════════════════════════════════════════════════════════════════════════
// Đợt C (01/08, docs/QUYET-DINH-HA-TANG-2026-07-31.md §③, phương án C) — bộ học "Gu"
// (lib/gu/pairwise-perceptron.ts) chuyển từ CHỈ localStorage sang Prisma LÀ NGUỒN, kèm
// đường xuất/nhập tệp (yêu cầu, xem đường dẫn ở lib/gu/gu-model-sync.ts). weightsJson =
// nguyên văn PairwisePerceptron.serialize() (JSON thuần, xem PerceptronState) — KHÔNG tách
// cột theo từng trọng số (vector thưa, key động theo feature, tách cột là vô nghĩa).
// kind PHÂN LOẠI theo điểm cắm (mỗi điểm cắm học riêng, không trộn): hiện có
// 'cad-layout-option' (components/cad/AiBriefPanel.tsx). 0a (31/07) đã khoá theo userId ở
// tầng localStorage — model Prisma này THỪA KẾ nguyên tắc đó qua @@unique([userId, kind]),
// và CŨNG bắt đầu lại từ 0 (không di trú trọng số cũ) vì lý do giống hệt 0a: khoá
// localStorage cũ là chuỗi cố định, có thể đã trộn nhiều người dùng — coi là dữ liệu bẩn.
// ══════════════════════════════════════════════════════════════════════════
model GuModel {
  id          String   @id @default(cuid())
  userId      String
  kind        String // 'cad-layout-option' | 'present-template' (điểm cắm nào học riêng điểm đó)
  weightsJson String // PairwisePerceptron.serialize() nguyên văn
  pairCount   Int      @default(0) // cache của PerceptronState.pairsSeen — hiển thị nhanh, không phải nguồn
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind])
}

// ══════════════════════════════════════════════════════════════════════════
// Home/Gallery ↔ Larkbase (docs/RESEARCH-HOME-GALLERY-DASHBOARD.md) — M1.
// PULL-ONLY tuyệt đối: Larkbase là nguồn chân lý, IF chỉ đọc/mirror, KHÔNG BAO GIỜ ghi ngược
// (không create_record/update_record tự động — xem §2.4 báo cáo). Cùng mẫu hình MaterialRef
// đã đề xuất ở RESEARCH-MATERIAL-BRIDGE.md §2: bảng mirror cache đọc + field `raw` JSON giữ
// nguyên toàn bộ dữ liệu gốc (tương lai-proof, Larkbase thêm cột không cần migrate).
// ══════════════════════════════════════════════════════════════════════════

// Mirror bảng "Chi tiết công việc" (tblnjLehkr6DRMJN mặc định, xem LARK_TASK_TABLE_ID).
model LarkTaskRef {
  id              String    @id @default(cuid())
  larkRecordId    String    @unique // record_id thật — khoá đối chiếu khi sync lại (idempotent)
  task            String // Công việc (fldwbtnkvV)
  larkProjectName String // Dự án — TEXT TỰ DO bên Larkbase (fldJtylsyv)
  larkProjectCode String? // Mã DA (fldhMYuiEN) — "Khác"/rỗng/không phải số → null
  ownerAccount    String? // Chủ trì — Tài khoản Lark (fldgKYaap5), CHƯA map User.id
  status          String // Trạng thái: 'Đang làm'|'Hoàn thành'|'Ghi nhận' (fldfhchOp2)
  deadline        DateTime? // fldhG7EqAa
  daysLeft        Int? // Số ngày còn lại — ĐỌC TỪ FORMULA CÓ SẴN (fldKUidfNt)
  warningLabel    String? // Cảnh báo — ĐỌC TỪ FORMULA CÓ SẴN (fldz1WLW4y), giữ emoji
  raw             String // JSON toàn bộ field gốc Larkbase
  syncedAt        DateTime  @default(now())

  @@index([larkProjectCode])
  @@index([status])
}

// Mirror bảng "Nhân sự" (tblUvVYG5j70FCTn mặc định, xem LARK_HR_TABLE_ID). BỔ SUNG so với
// danh sách model gốc trong báo cáo (chỉ liệt LarkTaskRef/LarkUserMap) — cần 1 nơi lưu roster
// cho tab "Nhân sự" của panel "Chi tiết" (không có field nhạy cảm, xem báo cáo §1.5/§3: chỉ
// Tài khoản/Họ tên/Chức danh/Phòng ban/checkbox Team Crea, an toàn hiện công khai nội bộ).
// Cùng mẫu pull-only/idempotent như LarkTaskRef — KHÔNG phải "phát minh cơ chế lưu token mới",
// đây là mirror DỮ LIỆU, không phải lưu credential.
model LarkPersonRef {
  id           String   @id @default(cuid())
  larkRecordId String   @unique
  larkAccount  String   @unique // Tài khoản (fldRj0Rxqj, primary) — vd "An.LNT"
  fullName     String // Họ tên (fldrqrWgRL)
  title        String? // Chức danh (fldk6eUee1)
  department   String? // Phòng ban (fldtdBj7Vw)
  isCrea       Boolean  @default(false) // Team Crea (fldvno5ztZ, checkbox)
  raw          String
  syncedAt     DateTime @default(now())
}

// ══════════════════════════════════════════════════════════════════════════
// Hệ Legend (docs/PROPOSAL-LEGEND-SYSTEM.md §2, X1) — spec sản phẩm/vật liệu THỐNG NHẤT,
// nguồn dữ liệu cho MỌI legend/schedule/spec-sheet ở cả 3 chặng. Quyết định Q-L2 đã chốt:
// GỘP MaterialRef (RESEARCH-MATERIAL-BRIDGE) vào đây với kind='material' — 1 bảng duy nhất.
// Giá mirror Larkbase pull-only (mẫu LarkTaskRef) nhưng ĐỂ TRỐNG được — Q1 bridge chưa chốt.
// ══════════════════════════════════════════════════════════════════════════
model ProductSpec {
  id           String    @id @default(cuid())
  kind         String // 'furniture' | 'material' | 'lighting' | 'millwork' | 'fixture'
  name         String // "Ghế Volumen Lounge"
  nameEn       String? // song ngữ TTT: "Volumen Lounge Chair"
  brand        String?
  sku          String?
  vendor       String?
  // kích thước danh nghĩa mm (khớp BlockDef.w/h; d = sâu, hUp = cao thật 3D cho spec sheet)
  w            Int?
  d            Int?
  hUp          Int?
  materials    String    @default("") // JSON string[] — ['oak','linen']
  finishes     String    @default("") // JSON string[] — fabric/finish options
  colorHex     String? // swatch chính
  imageAssetId String? // FK mềm LibraryAsset — lưu-theo-tham-chiếu
  drawingBlock String? // key BlockDef/manifest id — line drawing top-view có sẵn
  priceNote    String? // text tự do "1.250.000đ/cái" — chưa chuẩn hoá số, GIỮ cho hiển thị/legacy
  currency     String? // 'VND' | 'USD' | 'EUR'
  larkRecordId String?   @unique // khoá sync nếu record đến từ Larkbase
  raw          String? // JSON field gốc Larkbase (mẫu LarkTaskRef)
  note         String?
  createdAt    DateTime  @default(now())
  syncedAt     DateTime?

  // ── 2.1.9.r (30/07) — mở rộng cho BOQ, THAY vì bảng AtlasMaterial riêng (Luật Đồng Bộ #6,
  // Hoà xác nhận): ProductSpec{kind:'material'} đã là "1 bảng duy nhất" theo Q-L2 trước đó, thêm
  // field còn thiếu thay vì tạo bảng cạnh tranh. priceNote (text tự do) GIỮ NGUYÊN cho hiển thị/
  // tương thích ngược — priceVnd là SỐ THẬT dùng cho phép tính BOQ (Decimal, không làm tròn giữa
  // chừng — xem lib/cad/schedule.ts khi 2.1.9.p dùng tới).
  unit           String? // đơn vị tính BOQ: 'm2' | 'm' | 'cai' | 'bo' | 'm3' | ... (không ràng buộc enum — Lark có thể thêm đơn vị mới)
  priceVnd       Decimal? // giá tham khảo, SỐ THẬT (VND, Decimal — KHÔNG Float, tránh sai số nhị phân khi tính BOQ) — dùng cho amount = qty × giá. Song song priceNote (text tự do, GIỮ NGUYÊN cho hiển thị+truy nguồn), KHÔNG parse priceNote sang số (sai 1 dòng = sai tiền thật, âm thầm). null = "chưa có giá" — BOQ phải HIỆN rõ, không đoán, không bỏ qua dòng.
  wastagePercent Decimal? // hao hụt % khi thi công (vd 5 = 5%) — đọc từ ATLAS khi sync, KHÔNG hard-code trong app. BOQ cộng vào qty_exec→qty_order.
  packagingSpec  String? // quy cách đóng gói/thương mại, vd "4 viên/thùng = 1,44 m²" — dùng để CEILING ra số đơn vị đóng gói (qty_order). KHÁC drawingBlock (hình học bản vẽ).
  altSku         String? // mã thay thế/tương đương khi hết hàng — text tự do, chưa chuẩn hoá thành bảng riêng
  styleTags      String   @default("") // JSON string[] — cùng mẫu materials/finishes ở trên, mầm STYLE_DNA nối Gu Engine

  // ── Kho vật liệu IF v1 (04/08, docs/PHIEU-CODE-IF-KHO-VAT-LIEU-V1.md VIỆC 1) — khai chỗ cho
  // kho 3 tầng (① chung / ② studio / ③ dự án chỉ tham chiếu). CHỈ khai cột, CHƯA code chức năng
  // cho scope='global' — lý do: IF có 0 studio ngoài TTT, chưa phá được vòng con-gà-quả-trứng.
  // Khai sớm để tránh phải migrate dữ liệu của MỌI khách hàng khi có nhà cung cấp đầu tiên.
  scope      String   @default("studio") // 'global' | 'studio'
  ownerId    String? // null = kho chung; ngược lại = studio sở hữu
  supplierId String? // hãng cung cấp — chưa có bảng Supplier riêng, để string trước
  verified   Boolean  @default(false) // IF đã duyệt chưa — chỉ có nghĩa khi scope='global'

  // ── Bảng FF&E theo phòng (06/08, G-M3-08 trong docs/GAP-IF.md) — CHỈ KHAI CỘT, CHƯA MIGRATE.
  // Vấn đề: bản ghi sản phẩm không có trường phòng/vị trí ⇒ bảng FF&E theo phòng không có chỗ
  // lưu, không thống kê được "phòng này gồm những món nào".
  // ⚠️ Ranh giới ngữ nghĩa (đọc trước khi dùng): ProductSpec là DANH MỤC — "món này TỒN TẠI, giá
  // bao nhiêu". Phòng/độ tin cậy vốn thuộc về LẦN XUẤT HIỆN của món trong một dự án (FfeItem,
  // lib/ffe/item.ts). Hai cột dưới là chỗ cho ca THỰC DỤNG: studio nhập nguyên bảng FF&E của MỘT
  // dự án vào kho và muốn giữ nguyên cột phòng; KHÔNG phải chỗ để nhét mọi lần xuất hiện. Nhiều
  // dự án cùng dùng một món thì món ở FfeItem, không nhân bản ProductSpec ra.
  // 🔴🔴 CHƯA CHẠY `prisma migrate` — HAI CỘT DƯỚI ĐANG LÀ MỘT QUẢ MÌN, ĐỌC KỸ TRƯỚC KHI LÀM GÌ.
  //
  // ⚠️ ĐÍNH CHÍNH 06/08 (vòng 3): cảnh báo cũ ở đây ghi nguy cơ là "vỡ tsc / đừng tham chiếu
  // room/confidence qua prisma.productSpec.*" — SAI BẢN CHẤT, và sai theo hướng làm người đọc yên
  // tâm. Sự thật đã chứng minh: **Prisma tự SELECT MỌI cột scalar đã khai trong schema**, không
  // cần ai viết tên cột ra cả. Nên chỉ cần MỘT lần `npx prisma generate` chạy (kể cả do
  // `npm install` gọi `postinstall`, không ai chủ động gõ) mà DB chưa `db push` là **mọi lệnh
  // đọc/ghi ProductSpec CHẾT Ở RUNTIME**:
  //     The column `main.ProductSpec.room` does not exist in the current database.
  // Kéo theo: kho vật liệu · BOQ · `/api/specs` · ATLAS sync — tức gần như cả nhánh vật tư.
  // Cờ `SPEC_ROOM_COLUMN_READY` (`lib/server/specs.ts`) KHÔNG cứu được ca này: nó chỉ chặn code
  // của IF đụng vào 2 cột, không chặn được câu SELECT do chính Prisma sinh ra.
  //
  // ⇒ TUYỆT ĐỐI KHÔNG xoá 2 cột (schema là hợp đồng đã chốt, G-M3-08) và KHÔNG chạy migrate qua
  //   sandbox (FUSE không khoá được file SQLite — xem `docs/00-CHOT.md` LUẬT VẬN HÀNH).
  // ⇒ Chủ dự án chạy TRÊN MÁY THẬT, theo đúng thứ tự này, khi không có dev server nào đang mở:
  //       sqlite3 dev.db ".backup 'dev.db.bak-truoc-room-confidence'"
  //       npx prisma db push        # hoặc: npx prisma migrate dev --name productspec-room-confidence
  //       npx prisma generate
  //   Xong thì gỡ cờ `SPEC_ROOM_COLUMN_READY` và xoá luôn khối cảnh báo này.
  // ⇒ Trong lúc chờ: KHÔNG chạy `npm install`/`prisma generate` trên máy có dữ liệu thật nếu chưa
  //   sẵn sàng `db push` ngay sau đó — hai lệnh đó phải đi liền nhau.
  room       String? // phòng/khu vực, chuỗi tự do theo nhãn phòng trên bản vẽ — KHÔNG ép enum
  confidence String? // 'measured' | 'inferred' | 'manual' (khớp FfeConfidence, lib/ffe/item.ts)

  @@index([kind])
  @@index([sku])
  @@index([drawingBlock])
  @@index([scope])
  @@index([ownerId])
}

// Ánh xạ TAY 1 lần: "Tài khoản" Larkbase (vd "An.LNT") ↔ User.id nội bộ IF — Larkbase KHÔNG
// dùng cùng định danh (tên đầy đủ/email) nên không tự suy đoán được (báo cáo §3, câu hỏi (f)).
// Phân quyền app KHÔNG phụ thuộc bảng này (đã chốt tách biệt hoàn toàn — ProjectMember riêng,
// xem RESEARCH-ACCESS-CONTROL.md); đây chỉ để HIỂN THỊ (tooltip chức danh/phòng ban, cột
// "Chủ trì" trong bảng phẳng) và pre-fill gợi ý sau này, không quyết quyền truy cập.
//
// ⚠️ DEPRECATED-ĐANG-CHUYỂN (M-SCOPE VIỆC 3, 07/08) — bảng cầu ID này đang được thay thế dần
// bởi `ExternalRef{system:'lark', entityType:'person'}` (L-EXT1, §0v). Ghi/đọc MỚI phải qua
// `lib/integrations/lark-bridge.ts` (dual-write: vẫn ghi bảng này làm nguồn chính hôm nay +
// ghi thêm ExternalRef khi bảng đó đã migrate) — KHÔNG gọi `prisma.larkUserMap.*` trực tiếp ở
// route mới. GIỮ NGUYÊN bảng này (KS4, lùi được) — chỉ xoá sau khi ExternalRef đã là nguồn
// chính ổn định VÀ đã chạy xong script chép dữ liệu (xem lark-bridge.ts docblock).
model LarkUserMap {
  id          String   @id @default(cuid())
  larkAccount String   @unique
  userId      String
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────────────────────
// L-EXT1 · BẢNG CẦU ID HỆ NGOÀI — §0v "lõi không mang tên nhà cung cấp" (Hoà chốt 06/08)
//
// Vì sao có bảng này: hôm nay tên MỘT nhà cung cấp đang nằm trong TÊN CỘT của bảng lõi (8 cột,
// §0v liệt kê đủ). Đổi/mất nhà cung cấp ⇒ phẫu thuật lõi + migrate + sửa hàng chục file. Ví von
// của §0v: đang mượn cột chịu lực của nhà hàng xóm, đúng ra nó phải là giàn giáo — tháo được mà
// nhà vẫn đứng.
//
// Từ nay: ID của MỌI hệ ngoài nằm ở ĐÂY, không đẻ cột mới trong bảng lõi. `system` là chuỗi tự do
// do adapter khai, cố ý KHÔNG enum — thêm nhà cung cấp mới không phải đụng schema.
//
// ⛔ 8 cột cũ GIỮ NGUYÊN, KHÔNG migrate dữ liệu đợt này (§0v: "chỉ ngừng đẻ mới"). Đây là đường
//    SONG SONG, chưa ai đọc/ghi — xem `lib/integrations/external-ref.ts`.
//
// ⚠️ Khối chú thích này CỐ Ý không viết literal tên nhà cung cấp: phép kiểm §0v là
//    phép grep tên nhà cung cấp trong file này đếm THÔ theo dòng, nên chỉ cần nhắc tên trong
//    comment là con số phồng lên và phiên sau tưởng có cột mới. Phép kiểm đúng (đếm KHAI BÁO
//    TRƯỜNG, bỏ comment) nằm ở `lib/integrations/external-ref.test.ts`.
//
// 🔴 CHƯA CHẠY MIGRATE. Bảng này chưa tồn tại trong `dev.db`. Mọi hàm đụng tới nó đều chặn sau cờ
//    `EXTERNAL_REF_TABLE_READY` (`lib/integrations/external-ref.ts`) — cùng lối `SPEC_ROOM_COLUMN_READY`
//    (`lib/server/specs.ts`). Lệnh cho chủ dự án chạy trên máy thật: xem `docs/M-APPLY-C-OUT.md` §10.
// ─────────────────────────────────────────────────────────────────────────────
// ─────────────────────────────────────────────────────────────────────────────
// M-SCOPE VIỆC 2 (07/08) — Task nội bộ + WorkflowState. Trước đây IF không có model
// "việc" nào của riêng mình — chỉ có `LarkTaskRef` (mirror pull-only từ Larkbase, xem
// khối chú thích phía trên). Hai model dưới đây là NGUỒN SỰ THẬT nội bộ IF, độc lập Lark.
//
// ⚠️ status KHÔNG phải String tự do đối chiếu bằng mắt — dựng riêng `WorkflowState` để mỗi
//    dự án tự khai bộ trạng thái của MÌNH (tên/thứ tự/cột nào coi là "xong"), tránh việc
//    "Đang làm" viết hoa lệch "đang làm" làm vỡ cột Kanban. Vẫn trung tính: app không áp đặt
//    bộ trạng thái cứng.
// ⚠️ Task.projectId KHÔNG được đọc/ghi qua `Project.currentStage` hay `lib/phases.ts` — ba
//    chặng concept/render/present là PIPELINE kỹ thuật của IF (2D/3D/Trình chiếu), KHÔNG phải
//    giai đoạn hợp đồng ngành (Ý tưởng→Cơ sở→Kỹ thuật→Thi công→Giám sát). Trùng tên là bẫy,
//    xem cảnh báo trong phiếu M-SCOPE VIỆC 2.
//
// 🔴 CHƯA CHẠY MIGRATE — 2 bảng này chưa tồn tại trong `dev.db`. Cùng lối chặn `ExternalRef`
//    ở trên: mọi hàm đụng tới đều chặn sau cờ `TASK_TABLES_READY` (`lib/server/tasks.ts`).
//    Lệnh cho chủ dự án chạy trên máy thật (không dev server nào đang mở):
//      sqlite3 dev.db ".backup 'dev.db.bak-truoc-task'"
//      npx prisma db push   # hoặc: npx prisma migrate dev --name task-workflow-state
//      npx prisma generate
//    rồi đổi TASK_TABLES_READY thành true.
// ─────────────────────────────────────────────────────────────────────────────
model WorkflowState {
  id        String   @id @default(cuid())
  projectId String
  name      String // "Chưa làm" | "Đang làm" | "Xong" ... — dự án tự khai, không ép enum
  order     Int      @default(0) // thứ tự cột hiển thị (trái→phải)
  isActive  Boolean  @default(true) // false = ngừng dùng (giữ lịch sử, KHÔNG xoá — KS4)
  isDone    Boolean  @default(false) // cột này = "coi như xong việc" (đóng-mở báo cáo tiến độ)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId])
}

model Task {
  id          String    @id @default(cuid()) // id do IF sinh — KHÔNG phải id Lark
  projectId   String
  title       String
  statusId    String
  assigneeIds String    @default("") // JSON string[] User.id — nhiều người phụ trách 1 việc
  startAt     DateTime?
  dueAt       DateTime?
  order       Int       @default(0) // thứ tự trong cột (kéo-thả)

  /// TaskContext Link (chốt 11/08 — SPEC-KHOI-TAO-DU-AN §"Dây sang ngữ cảnh"): việc mang ngữ
  /// cảnh {stage, workspace, entity} để bấm là nhảy đúng chỗ. Cả 3 optional — việc không ngữ
  /// cảnh vẫn hợp lệ. `stage` ∈ 'concept'|'render'|'present' (ID kỹ thuật lib/phases.ts, KHÔNG
  /// đổi). `workspaceId` là khoá tự do (vd 'cad','board','present') — cố ý không enum.
  stage       String?
  workspaceId String?
  entityId    String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status  WorkflowState @relation(fields: [statusId], references: [id])

  @@index([projectId])
  @@index([statusId])
}

model ExternalRef {
  id String @id @default(cuid())

  /// mã hệ ngoài do adapter khai (`lib/integrations/registry.ts`). Chuỗi tự do, cố ý KHÔNG enum.
  system String

  /// id bản ghi BÊN HỆ NGOÀI (vd record_id của Larkbase).
  externalId String

  /// loại thực thể LÕI IDF — vd 'task' | 'project' | 'person' | 'material'.
  entityType String

  /// id thực thể lõi IDF (id do IF sinh, không phải id hệ ngoài).
  entityId String

  /// M-SCOPE VIỆC 4 (07/08) — CHỐNG VÒNG LẶP ĐỒNG BỘ 2 CHIỀU. `lastWriteBy` = ai ghi lần cuối
  /// vào cặp (system, externalId) này: 'idf' (IF vừa đẩy ra hệ ngoài) hoặc chính `system` đó
  /// (hệ ngoài vừa đẩy ngược vào IF). `lastWriteAt` = lúc ghi đó. Bên nhận đổi từ hệ ngoài PHẢI
  /// tự hỏi: "mình vừa ghi cái này ra chưa quá 60s trước?" — có thì BỎ QUA (chính là tiếng vọng
  /// của lần ghi đó, không phải thay đổi mới) — xem `lib/integrations/anti-loop.ts`.
  /// null = chưa từng ghi qua đường 2 chiều này (chỉ đọc/pull một chiều, như hôm nay).
  lastWriteBy String?
  lastWriteAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// một bản ghi hệ ngoài chỉ trỏ tới đúng một thực thể lõi — khoá idempotent khi sync lại,
  /// thay vai trò mà cột `*RecordId @unique` mang tên nhà cung cấp đang gánh trong các bảng lõi.
  @@unique([system, externalId])
  /// chiều ngược: từ thực thể lõi tra ra mọi id ngoài của nó.
  @@index([entityType, entityId])
  @@index([system])
}
