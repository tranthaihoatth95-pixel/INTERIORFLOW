{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": false
  },
  "framework": "nextjs",
  "installCommand": "npm ci",
  "buildCommand": "prisma generate && next build",
  "regions": ["sin1"],
  "functions": {
    "app/api/**/route.ts": {
      "maxDuration": 60
    }
  }
}
