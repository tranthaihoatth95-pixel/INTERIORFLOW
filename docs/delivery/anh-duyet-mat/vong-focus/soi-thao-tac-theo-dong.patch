+   xuất hiện; xem 00-CHOT 04/09. */
+function bocChuThichCss(s) {
+  let ra = '', i = 0, trong = false;
+  while (i < s.length) {
+    const c = s[i], d = s[i + 1];
+    if (!trong && c === '/' && d === '*') { trong = true; ra += '  '; i += 2; continue; }
+    if (trong && c === '*' && d === '/') { trong = false; ra += '  '; i += 2; continue; }
+    ra += trong ? (c === '\n' ? c : ' ') : c;
+    i++;
+  }
+  return ra;
+}
